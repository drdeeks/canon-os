# Canon OS — gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Node (web/api interfaces)
node_modules/
dist/
*.tsbuildinfo

# Local state & secrets (never committed)
.secrets/
.studio/
.trash/

# Env / credentials
.env
*.env
*.key
*.pem

# Editor / OS
.DS_Store
*.swp
.idea/

# Built artifacts
build/
*.egg-info/
